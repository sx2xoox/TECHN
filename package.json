{
  "name": "isomorph",
  "private": true,
  "version": "0.1.0",
  "description": "ISOMORPH — 모든 소프트웨어를 살아있는 세계로 바꾸는 역(逆) 디지털 트윈 엔진",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "demo": "tsx scripts/demo.ts",
    "dev:client": "npm run dev -w @isomorph/client",
    "build": "npm run build -w @isomorph/client",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bench:compile": "tsx scripts/bench-compile.ts",
    "assets": "tsx packages/assets/src/cli.ts",
    "e2e": "tsx scripts/e2e.ts",
    "bench:latency": "tsx scripts/bench-latency.ts",
    "stress": "echo \"브라우저에서 http://127.0.0.1:4000/?stress=10000 (npm run demo 실행 중)\"",
    "demo:agent": "tsx scripts/demo-agent.ts",
    "demo:otel": "tsx scripts/demo-otel.ts",
    "bench:lab": "tsx scripts/bench-lab.ts",
    "bench:real": "tsx scripts/bench-real-schemas.ts",
    "bench:heldout": "tsx scripts/bench-heldout-schemas.ts",
    "bench:a11y": "tsx scripts/bench-a11y.ts",
    "study": "tsx scripts/study.ts",
    "study:analyze": "tsx scripts/study-analyze.ts",
    "study:selftest": "tsx scripts/study-selftest.ts",
    "study:power": "tsx scripts/study-power.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
